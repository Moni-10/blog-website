RewriteEngine On

# Reject malformed Host headers before any redirect uses that value.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(:[0-9]+)?$ [NC]
RewriteRule ^ - [F,L]

# Redirect to HTTPS + non-www (safe, fixed, server-controlled — never a
# user-supplied redirect target).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Never allow these to be requested directly over HTTP, even if the rewrite
# rules below are misconfigured.
RewriteRule ^includes/ - [F,L]
RewriteRule ^cache/ - [F,L]
RewriteRule ^logs/ - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(bak|backup|old|orig|save|sql|sqlite|ini|sh|ps1)$ - [F,L,NC]
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|\.env)$ - [F,L,NC]

# Pretty URLs. Order matters: pagination variants first, then the bare form.
RewriteRule ^category/([a-z0-9-]+)/page/([0-9]+)/?$ category.php?slug=$1&page=$2 [L,QSA]
RewriteRule ^category/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog.php?slug=$1 [L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]

# sitemap.xml is now served as the static file in this folder.

<FilesMatch "\.(json|log|md)$">
  Require all denied
</FilesMatch>

Options -Indexes
ServerSignature Off

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

ErrorDocument 404 /404.php
ErrorDocument 500 /404.php